# ===========================================================================
# ImmoOffice.ai — Vorlage fuer Umgebungsvariablen
#
# Diese Datei dokumentiert die STRUKTUR. Sie enthaelt niemals echte Werte.
# Kopieren nach .env.local (lokal) beziehungsweise in die Netlify-Umgebung.
#
# Regel: Nur Variablen mit dem Praefix NEXT_PUBLIC_ erreichen den Browser.
# Alles ohne dieses Praefix bleibt serverseitig und darf niemals in
# Client-Komponenten importiert werden.
# ===========================================================================

# --- Supabase ---------------------------------------------------------------
# Projekt "immooffice", Region eu-central-1 (Frankfurt). Kein neues Projekt
# anlegen (Master-Prompt Abschnitt 0).
# --- Oberflaeche des Forks (scripts/bauen.py setzt sie in dist/index.html) ---
# Beide sind oeffentlich — der anon-Schluessel steht in jeder ausgelieferten
# Datei. Sie stehen hier trotzdem als Variablen und nicht im Quelltext, damit
# derselbe Quellstand fuer verschiedene Projekte baut und kein Schluessel im
# Repository liegt.
IMMO_SUPABASE_URL="https://<projekt-referenz>.supabase.co"
IMMO_SUPABASE_KEY=""

NEXT_PUBLIC_SUPABASE_URL="https://<projekt-referenz>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Dienstschluessel mit vollen Rechten. NUR serverseitig, umgeht saemtliche
# Row-Level-Security. Ausschliesslich fuer Benutzereinladung, Webhooks und
# Hintergrundjobs verwenden — niemals in einer Client-Komponente.
SUPABASE_SERVICE_ROLE_KEY=""

# --- KI-Anbieter ------------------------------------------------------------
# Hinter einem austauschbaren Provider-Layer (Abschnitt 4 und 10).
OPENAI_API_KEY=""
OPENAI_TEXTMODELL="gpt-5"
OPENAI_BILDMODELL="gpt-image-1"
# EU-Datenresidenz aktivieren, sofern im eingesetzten Konto verfuegbar.
OPENAI_DATENREGION="eu"

# Der zweite Anbieter, den die Vorlage benutzt: Textauslese, Mailvorschlaege,
# Dateinamen, Exposetexte und das Auslesen alter Grundrisse laufen darueber.
ANTHROPIC_API_KEY=""
# Modell fuer das Auslesen eines Bestandsgrundrisses (Edge Function
# grundriss-ki-lesen). Steht die Variable nicht, nimmt die Funktion das
# Modell, das auch die uebrigen Textfunktionen benutzen. Als Variable, weil
# ein Bildmodell haeufiger wechselt als die Funktion.
GRUNDRISS_KI_MODELL=""
# Modell fuer den KI-Assistenten im Chat-Fenster (Edge Function ki-assistent,
# fork_83). Leer = der Eintrag im Plattform-Admin, sonst claude-sonnet-4-6.
KI_ASSISTENT_MODELL=""
# Modell fuer die Pruefung auf private Details (Edge Function
# bild-privat-retusche, Schritt 1: sehen).
PRIVAT_SEH_MODELL=""

# Bildbearbeitung. Darueber laufen ki-bildbearbeitung (Retusche, Himmel,
# Homestaging, Atmosphaere-Stile) und Schritt 2 von bild-privat-retusche
# (der Retusche-Vorschlag). Ohne den Schluessel gibt es kein bearbeitetes
# Bild; die Pruefung auf private Details meldet ihren Befund trotzdem.
REPLICATE_API_TOKEN=""

# Alternativ ein EU-gehosteter Anbieter, ohne Architekturaenderung nutzbar.
# AZURE_OPENAI_ENDPOINT=""
# AZURE_OPENAI_API_KEY=""

# --- Stripe -----------------------------------------------------------------
# AUSSCHLIESSLICH TESTMODUS. Die Funktionen weisen jeden Schluessel ab, der
# nicht mit sk_test_ beginnt. Der Live-Gang ist Sache des Betreibers (Gate 3
# in CLAUDE.md) und verlangt, diese Pruefung bewusst zu entfernen — genau so
# soll es sein: er darf nicht aus Versehen passieren.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Der Gruender-Coupon. Angelegt von scripts/stripe-einrichten.mjs; hier steht
# nur sein Name, damit abo-checkout ihn setzen kann.
STRIPE_COUPON_GRUENDER="GRUENDER"

# KEINE Preis-IDs mehr in der Umgebung. Sie stehen seit fork_47 in
# plattform_tarife und plattform_credit_pakete — geschrieben von
# scripts/stripe-einrichten.mjs, aenderbar im Plattform-Admin. Zwei Orte fuer
# dieselbe Kennung waeren zwei Orte, von denen einer irgendwann falsch ist.
# --- E-Mail -----------------------------------------------------------------
# Zwei Wege, und beide sind in Gebrauch:
#
#   1. Das POSTFACH DES MANDANTEN (mail_postfaecher): IMAP zum Abholen,
#      SMTP zum Senden. Zugangsdaten stehen je Postfach in der Datenbank,
#      das Passwort verschluesselt (AES-GCM) — nicht hier. Den Schluessel
#      dafuer haelt MAIL_SECRET_KEY. Ohne ihn laesst sich kein Postfach
#      entschluesseln und kein Abruf laeuft.
#   2. Der PLATTFORM-VERSAND fuer Mails, die kein Postfach haben
#      (Einladungen, Erinnerungen, Freigabe- und Meldemails): Resend.
#
# Die Namen sind die, die die Edge Functions wirklich lesen. Vorher standen
# hier drei erfundene (MAIL_API_KEY, MAIL_ABSENDER, MAIL_ABSENDER_NAME) —
# gesetzt haetten sie nichts bewirkt.
MAIL_SECRET_KEY=""
RESEND_API_KEY=""

# Absender des Plattform-Versands. Die Domain muss dem Versanddienst
# nachgewiesen sein (SPF/DKIM), sonst weist er die Mail ab. Je Mandant
# wechseln nur Anzeigename und Antwortadresse — eigene Absenderdomains je
# Mandant gehoeren zur Anbieter-Schicht (Phase 6, siehe docs/OFFEN.md).
SMTP_FROM_EMAIL="noreply@<eigene-domain>"
SMTP_FROM_NAME="immoOffice.ai"

# Rueckfall-SMTP der Plattform, wenn Resend nicht gesetzt ist. Fuer den
# Betrieb reicht einer der beiden Wege.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""

# Empfaenger der Rechnungsweiterleitung aus dem Posteingang.
BUCHHALTUNG_EMAIL=""

# --- Weitere Werte, die die Edge Functions lesen ----------------------------
# Grundadresse der Expose-Freigabeseite (Rueckfall: PORTAL_URL).
EXPOSE_FREIGABE_BASIS=""
# Schluessel, mit dem Zugangsdaten fremder Dienste in der Datenbank
# verschleiert liegen (Portal-FTP, CRM).
CREDENTIALS_OBF_SECRET=""
# Push-Mitteilungen auf iOS (Apple Push Notification service) und das
# Geheimnis, mit dem der Datenbank-Trigger den Versand anstoesst.
APNS_TEAM_ID=""
APNS_KEY_ID=""
APNS_BUNDLE_ID=""
APNS_PRIVATE_KEY=""
APNS_UMGEBUNG="production"
PUSH_HOOK_SECRET=""
# fork_88: Geheimnis des Send-Email-Hooks von Supabase Auth (Dashboard →
# Authentication → Hooks → Send Email → Secret kopieren, Form v1,whsec_…).
# Ohne ihn weist auth-mail jeden Aufruf ab, und Supabase sendet weiter seine
# englische Vorlage.
AUTH_HOOK_SECRET=""

# --- Postfaecher der Kunden: Microsoft und Google ---------------------------
# Damit ein Makler sein Postfach mit zwei Klicks anbinden kann, muss die
# Plattform bei beiden Anbietern als Anwendung registriert sein. Das ist
# Sache des BETREIBERS, nicht des Mandanten: der Kunde stimmt nur zu.
#
# Microsoft (Entra ID / Azure): App registrieren, als Rueckleitung
#   https://<projekt>.supabase.co/functions/v1/postfach-anbieter-rueckruf
#   eintragen, Berechtigungen IMAP.AccessAsUser.All und SMTP.Send (delegiert)
#   setzen. Ein Geheimnis erzeugen und hier eintragen.
# Google (Cloud Console): OAuth-Client (Webanwendung) mit derselben
#   Rueckleitung. ACHTUNG: der Bereich https://mail.google.com/ ist ein
#   "restricted scope" — fuer den Produktivbetrieb prueft Google die
#   Anwendung (CASA). Ohne diese Pruefung geht es nur mit eingetragenen
#   Testnutzern. Siehe docs/OFFEN.md.
#
# Fehlt ein Paar, bleibt der zugehoerige Knopf in der Oberflaeche grau und
# sagt warum. Postfaecher mit Server und Passwort (IMAP/SMTP) gehen ohne.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# --- Portalexport (Phase 2) -------------------------------------------------
# OpenImmo-Uebertragung. Zugangsdaten stellt der jeweilige Mandant bereit und
# werden verschluesselt in der Datenbank gehalten, nicht hier.
OPENIMMO_ANBIETERNUMMER=""

# --- Anwendung --------------------------------------------------------------
# Oeffentliche Adresse der Anwendung. Sie bildet die Grundlage der Links zu
# Web-Exposés. Ohne diesen Wert wird der Host der Anfrage verwendet — hinter
# einem Proxy kann das die falsche Domain sein.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Dieselbe Adresse, aber fuer die Edge Functions: PORTAL_URL steht in der
# Supabase-Umgebung, nicht in Netlify. Zwoelf Funktionen bauen daraus die
# Links in ihren Mails, und expose-pdf-erzeugen holt darueber die
# Exposé-Schriften nach, wenn eine im Eimer fehlt (sie liegen beim Bau unter
# dist/schriften/expose/). Ohne den Wert gibt es keine Selbstheilung — die
# Schriften muessen dann von Hand in den Eimer branding-assets unter
# fonts/expose/ geladen werden.
PORTAL_URL="http://localhost:3000"
# Hinweis: Zugangsdaten der Mandanten liegen verschluesselt in der
# Datenbank, aber unter zwei verschiedenen Schluesseln — MAIL_SECRET_KEY
# (Postfach-Passwoerter) und CREDENTIALS_OBF_SECRET (Portal- und
# CRM-Zugaenge), beide weiter unten. Ein dritter Name stand hier
# (VERSCHLUESSELUNG_SCHLUESSEL) und wurde von keiner Funktion gelesen.
