# ===========================================================================
# ImmoOffice.ai — Vorlage fuer Umgebungsvariablen
#
# Diese Datei dokumentiert die STRUKTUR. Sie enthaelt niemals echte Werte.
# Kopieren nach .env.local (lokal) beziehungsweise in die Netlify-Umgebung.
# Wie die Werte beschafft werden: docs/ANLEITUNG.md. Was gerade fehlt und was
# es blockiert: docs/ZUGAENGE_FEHLEND.md.
#
# Regel: Nur Variablen mit dem Praefix NEXT_PUBLIC_ erreichen den Browser.
# Alles ohne dieses Praefix bleibt serverseitig und darf niemals in
# Client-Komponenten importiert werden.
# ===========================================================================

# --- Dienste, die die Entwicklung selbst bedient (docs/AUTONOMIE.md 1.2) ----
# Nur lokal fuer CLI-Aufrufe noetig. NICHT nach Netlify uebertragen.
GITHUB_TOKEN=""                 # Personal Access Token, Rechte: repo, workflow
GITHUB_OWNER=""                 # GitHub-Benutzer oder -Organisation
GITHUB_REPO="immooffice"
NETLIFY_AUTH_TOKEN=""           # Netlify → User settings → Applications → Personal access tokens
NETLIFY_SITE_NAME="immooffice"
SUPABASE_ACCESS_TOKEN=""        # supabase.com → Account → Access Tokens
SUPABASE_PROJECT_REF="usguiggfciavwzkdfjgt"
SUPABASE_DB_PASSWORD=""         # Datenbank-Passwort des Projekts (fuer supabase db push)

# --- Supabase ---------------------------------------------------------------
# Projekt "immooffice", Region eu-central-1 (Frankfurt). Kein neues Projekt
# anlegen (Master-Prompt Abschnitt 0).
NEXT_PUBLIC_SUPABASE_URL="https://<projekt-referenz>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Dienstschluessel mit vollen Rechten. NUR serverseitig, umgeht saemtliche
# Row-Level-Security. Ausschliesslich fuer Benutzereinladung, Webhooks und
# Hintergrundjobs (Sync-Laeufe) verwenden — niemals in einer Client-Komponente.
SUPABASE_SERVICE_ROLE_KEY=""

# --- KI-Anbieter ------------------------------------------------------------
# Hinter einem austauschbaren Provider-Layer (Abschnitt 4 und 10).
OPENAI_API_KEY=""
OPENAI_TEXTMODELL="gpt-5"
OPENAI_BILDMODELL="gpt-image-1"
# EU-Datenresidenz aktivieren, sofern im eingesetzten Konto verfuegbar.
OPENAI_DATENREGION="eu"
# Zweiter Anbieter fuer Textaufgaben, ueber denselben Provider-Layer.
ANTHROPIC_API_KEY=""

# Alternativ ein EU-gehosteter Anbieter, ohne Architekturaenderung nutzbar.
# AZURE_OPENAI_ENDPOINT=""
# AZURE_OPENAI_API_KEY=""

# --- Stripe (Phase 3, zuerst Testmodus) -------------------------------------
# Abonnements, Zusatznutzer, Credit-Pakete (Abschnitt 14).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Preis-IDs aus Stripe. Betraege selbst werden in der Datenbank gepflegt und
# ueber den Plattform-Admin geaendert, nicht im Code (Abschnitt 14).
STRIPE_PREIS_STARTER_MONAT=""
STRIPE_PREIS_STARTER_JAHR=""
STRIPE_PREIS_PROFESSIONAL_MONAT=""
STRIPE_PREIS_PROFESSIONAL_JAHR=""
STRIPE_PREIS_BUSINESS_MONAT=""
STRIPE_PREIS_BUSINESS_JAHR=""
STRIPE_PREIS_ZUSATZNUTZER_MONAT=""
STRIPE_PREIS_ZUSATZNUTZER_JAHR=""
STRIPE_PREIS_CREDITS_KLEIN=""
STRIPE_PREIS_CREDITS_MITTEL=""
STRIPE_PREIS_CREDITS_GROSS=""

# --- E-Mail -----------------------------------------------------------------
# EU-/DSGVO-geeigneter Versanddienst fuer Transaktionsmails (Einladungen,
# Testphasen-Erinnerungen, Versand ohne verbundenes Postfach).
MAIL_API_KEY=""
MAIL_ABSENDER="noreply@<eigene-domain>"
MAIL_ABSENDER_NAME="ImmoOffice.ai"

# --- Postfaecher und Kalender (Phase 4) -------------------------------------
# OAuth-Registrierungen: Azure App Registration (Multi-Tenant) und Google
# Cloud OAuth-Client. Weiterleitungsadressen siehe docs/ANLEITUNG.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# --- Portalexport (Phase 2) -------------------------------------------------
# OpenImmo-Uebertragung. Zugangsdaten stellt der jeweilige Mandant bereit und
# werden verschluesselt in der Datenbank gehalten, nicht hier.
OPENIMMO_ANBIETERNUMMER=""

# --- Anwendung --------------------------------------------------------------
# Oeffentliche Adresse der Anwendung. Sie bildet die Grundlage der Links zu
# Web-Exposés und Einladungen. Ohne diesen Wert wird der Host der Anfrage
# verwendet — hinter einem Proxy kann das die falsche Domain sein.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Schluessel zur Verschluesselung mandantenspezifischer Zugangsdaten in der
# Datenbank (Integrationen, Postfaecher): AES-256-GCM, 32 Byte.
# Erzeugen mit: openssl rand -base64 32
# Ein Wechsel des Schluessels macht alle gespeicherten Zugangsdaten unlesbar;
# Mandanten muessten sie neu eingeben.
VERSCHLUESSELUNG_SCHLUESSEL=""
