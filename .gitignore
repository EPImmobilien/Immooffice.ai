# --- Referenzmaterial -------------------------------------------------------
# Die Referenz-Anwendung ist Arbeitsmaterial, kein Produktbestandteil. Sie traegt
# durchgehend Kennzeichen des Referenzunternehmens; ein Mitversionieren wuerde
# Abschnitt 2 des Master-Prompts unterlaufen. Siehe docs/BESTANDSAUFNAHME.md.
reference/*
!reference/README.md

# --- Abhaengigkeiten --------------------------------------------------------
node_modules/
.pnp/
.pnp.*

# --- Build ------------------------------------------------------------------
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- Test und Werkzeuge -----------------------------------------------------
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.eslintcache

# --- Umgebung: NIEMALS echte Geheimnisse versionieren -----------------------
.env
.env.*
!.env.example

# --- Netlify / Supabase -----------------------------------------------------
.netlify/
.supabase/
supabase/.temp/

# --- Betriebssystem und Editor ----------------------------------------------
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.idea/
.vscode/*
!.vscode/extensions.json

# --- Oberflaeche: vorerst nicht versioniert ---------------------------------
# src/ entsteht aus reference/epworld-src.html durch
# scripts/oberflaeche-zerlegen.py. Es ist bewusst noch NICHT im Repository:
# 58 % des Anwendungscodes liegen vorkompiliert vor, und in diesem Teil laesst
# sich die Streichung aus Phase 1.4 (Shop-TV) nicht sauber ausfuehren. Ein
# Zwischenstand, der das Neutralitaets-Gate nur mit einer Ausnahme passiert,
# waere ein Gate mit einem Loch. Sobald der Quelltext der vorkompilierten
# Abschnitte vorliegt, wird src/ versioniert. Siehe docs/OFFEN.md.
src/
