{
  "name": "immooffice-ai",
  "version": "0.0.1",
  "private": true,
  "description": "Mandantenfaehige SaaS-Plattform fuer Immobilienmakler und Immobiliensachverstaendige",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
